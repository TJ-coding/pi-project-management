{
  "name": "pi-project-management",
  "version": "0.1.0",
  "description": "Pi extension: persistent project management and adaptive planning layer for long-running human+agent projects.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "project-management",
    "planning",
    "dag"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "smoke:rpc": "node scripts/rpc-smoke.mjs",
    "smoke:workflow": "node scripts/rpc-smoke.mjs --prompt-file scripts/smoke-workflow.txt --expect-goal 'End-to-end tools' --expect-tool project_direction,project_gate,project_replan,project_run,project_decision,project_context,project_resume,project_review --timeout 600000",
    "smoke:commands": "node scripts/rpc-commands.mjs",
    "smoke:tui": "node scripts/demo-project.ts /tmp/pi-pm-demo --force && node scripts/run-tui-smoke.mjs",
    "demo": "node scripts/demo-project.ts /tmp/pi-pm-demo --force",
    "smoke": "npm run smoke:rpc && npm run smoke:commands && npm run smoke:tui"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "typebox": "1.3.7",
    "typescript": "^5.7.0",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
